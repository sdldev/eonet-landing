---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import CustomerNav from "../../components/CustomerNav.astro";
import "../../styles/portal.css";

export const prerender = false;

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000";
const sessionCookie = Astro.cookies.get('eonet_customer_session')?.value;

if (!sessionCookie) {
  return Astro.redirect('/portal/login');
}

type DashboardData = {
  customer: {
    id: string;
    customerNo: string;
    fullName: string;
    phone: string;
    email: string | null;
    status: string;
    package: { name: string; price: number; speed?: string } | null;
  };
  activeInvoice: {
    id: string;
    invoiceNumber: string;
    amount: number;
    remainingAmount: number;
    status: string;
    dueDate: string;
    period: string;
    paymentToken: string | null;
  } | null;
  recentPayments: {
    id: string;
    amount: number;
    method: string;
    paidAt: string;
    invoiceNumber: string;
  }[];
};

let data: DashboardData | null = null;
let errorMessage: string | null = null;

try {
  const res = await fetch(`${apiBase}/v1/customer/dashboard`, {
    headers: { Cookie: `eonet_customer_session=${sessionCookie}` },
  });

  if (res.ok) {
    const json = await res.json();
    data = json.data ?? json;
  } else if (res.status === 401) {
    Astro.cookies.delete('eonet_customer_session');
    return Astro.redirect('/portal/login');
  } else {
    const json = await res.json().catch(() => null);
    errorMessage = json?.error ?? 'Gagal memuat data dashboard.';
  }
} catch {
  errorMessage = 'Tidak dapat terhubung ke server.';
}

function formatCurrency(amount: number): string {
  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);
}

function statusBadge(status: string): { label: string; cls: string } {
  const map: Record<string, { label: string; cls: string }> = {
    paid: { label: 'Lunas', cls: 'portal-badge-paid' },
    issued: { label: 'Belum Bayar', cls: 'portal-badge-unpaid' },
    unpaid: { label: 'Belum Bayar', cls: 'portal-badge-unpaid' },
    overdue: { label: 'Jatuh Tempo', cls: 'portal-badge-overdue' },
    partially_paid: { label: 'Sebagian', cls: 'portal-badge-unpaid' },
    cancelled: { label: 'Batal', cls: 'portal-badge-cancelled' },
  };
  return map[status] ?? { label: status, cls: 'portal-badge-cancelled' };
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title="Dashboard — Portal EONET">
  <div class="portal-layout">
    <CustomerNav active="dashboard" />
    <main class="portal-main">
      {errorMessage ? (
        <div class="portal-alert portal-alert-error">{errorMessage}</div>
      ) : data ? (
        <>
          <div class="portal-page-header">
            <h1 class="portal-page-title">Dashboard</h1>
            <p class="portal-page-subtitle">
              Selamat datang, {data.customer.fullName}
            </p>
          </div>

          <!-- KPI Cards -->
          <div class="portal-kpi-grid">
            <div class="portal-kpi">
              <div class="portal-kpi-label">Paket</div>
              <div class="portal-kpi-value">{data.customer.package?.name ?? '-'}</div>
              {data.customer.package?.price && (
                <div class="portal-kpi-sub">{formatCurrency(data.customer.package.price)}/bulan</div>
              )}
            </div>
            <div class="portal-kpi">
              <div class="portal-kpi-label">Status Pelanggan</div>
              <div class="portal-kpi-value">{data.customer.status === 'active' ? 'Aktif' : data.customer.status}</div>
            </div>
            <div class="portal-kpi">
              <div class="portal-kpi-label">Kode Pelanggan</div>
              <div class="portal-kpi-value">{data.customer.customerNo}</div>
            </div>
          </div>

          <!-- Active Invoice -->
          {data.activeInvoice && (
            <div class="portal-card">
              <div class="portal-card-header">
                <h2 class="portal-card-title">Tagihan Aktif</h2>
                <span class={`portal-badge ${statusBadge(data.activeInvoice.status).cls}`}>
                  {statusBadge(data.activeInvoice.status).label}
                </span>
              </div>
              <div class="portal-info-grid">
                <div class="portal-info-item">
                  <span class="portal-info-label">No. Invoice</span>
                  <span class="portal-info-value">{data.activeInvoice.invoiceNumber}</span>
                </div>
                <div class="portal-info-item">
                  <span class="portal-info-label">Periode</span>
                  <span class="portal-info-value">{data.activeInvoice.period}</span>
                </div>
                <div class="portal-info-item">
                  <span class="portal-info-label">Total</span>
                  <span class="portal-info-value">{formatCurrency(data.activeInvoice.amount)}</span>
                </div>
                <div class="portal-info-item">
                  <span class="portal-info-label">Sisa Tagihan</span>
                  <span class="portal-info-value" style="color: #fca5a5;">{formatCurrency(data.activeInvoice.remainingAmount)}</span>
                </div>
                <div class="portal-info-item">
                  <span class="portal-info-label">Jatuh Tempo</span>
                  <span class="portal-info-value">{formatDate(data.activeInvoice.dueDate)}</span>
                </div>
              </div>
              {data.activeInvoice.paymentToken && data.activeInvoice.status !== 'paid' && (
                <div style="margin-top: var(--space-lg);">
                  <a href={`/portal/pay/${data.activeInvoice.paymentToken}`} class="portal-btn portal-btn-primary">
                    Bayar Sekarang
                  </a>
                </div>
              )}
            </div>
          )}

          {!data.activeInvoice && (
            <div class="portal-card">
              <div class="portal-empty">
                <div class="portal-empty-icon">&#10003;</div>
                <p class="portal-empty-text">Tidak ada tagihan aktif saat ini.</p>
              </div>
            </div>
          )}

          <!-- Recent Payments -->
          <div class="portal-card">
            <div class="portal-card-header">
              <h2 class="portal-card-title">Pembayaran Terakhir</h2>
              <a href="/portal/invoices" class="portal-btn portal-btn-secondary portal-btn-sm">Lihat Semua</a>
            </div>
            {data.recentPayments.length > 0 ? (
              <div class="portal-table-wrap">
                <table class="portal-table">
                  <thead>
                    <tr>
                      <th>No. Invoice</th>
                      <th>Tanggal</th>
                      <th>Metode</th>
                      <th>Jumlah</th>
                    </tr>
                  </thead>
                  <tbody>
                    {data.recentPayments.map((p) => (
                      <tr>
                        <td>{p.invoiceNumber}</td>
                        <td>{formatDate(p.paidAt)}</td>
                        <td>{p.method}</td>
                        <td>{formatCurrency(p.amount)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="portal-empty">
                <p class="portal-empty-text">Belum ada pembayaran.</p>
              </div>
            )}
          </div>

          <!-- Customer Info -->
          <div class="portal-card">
            <h2 class="portal-card-title" style="margin-bottom: var(--space-md);">Informasi Pelanggan</h2>
            <div class="portal-info-grid">
              <div class="portal-info-item">
                <span class="portal-info-label">Nama</span>
                <span class="portal-info-value">{data.customer.fullName}</span>
              </div>
              <div class="portal-info-item">
                <span class="portal-info-label">HP</span>
                <span class="portal-info-value">{data.customer.phone}</span>
              </div>
              <div class="portal-info-item">
                <span class="portal-info-label">Email</span>
                <span class="portal-info-value">{data.customer.email ?? '-'}</span>
              </div>
              <div class="portal-info-item">
                <span class="portal-info-label">Kode Pelanggan</span>
                <span class="portal-info-value">{data.customer.customerNo}</span>
              </div>
            </div>
          </div>
        </>
      ) : null}
    </main>
  </div>
  <Footer />
</Layout>
