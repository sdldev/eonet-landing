---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import CustomerNav from "../../../components/CustomerNav.astro";
import "../../../styles/portal.css";

export const prerender = false;

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000";
const sessionCookie = Astro.cookies.get('eonet_customer_session')?.value;

if (!sessionCookie) {
  return Astro.redirect('/portal/login');
}

// Fetch categories
let categories: Array<{ id: string; name: string }> = [];
try {
  const res = await fetch(`${apiBase}/v1/admin/ticket-categories`, {
    headers: { Cookie: `eonet_customer_session=${sessionCookie}` },
  });
  if (res.ok) {
    const json = await res.json();
    categories = json.data ?? json ?? [];
  }
} catch { /* ignore */ }

// Handle form submission
let errorMessage: string | null = null;
let success = false;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const subject = formData.get('subject') as string;
    const description = formData.get('description') as string;
    const category_id = formData.get('category_id') as string;

    if (!subject?.trim() || !description?.trim()) {
      errorMessage = 'Subjek dan deskripsi wajib diisi.';
    } else {
      const res = await fetch(`${apiBase}/v1/customer/tickets`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Cookie: `eonet_customer_session=${sessionCookie}`,
        },
        body: JSON.stringify({ subject, description, category_id: category_id || undefined }),
      });

      if (res.ok) {
        return Astro.redirect('/portal/tickets');
      } else if (res.status === 401) {
        return Astro.redirect('/portal/login');
      } else {
        const json = await res.json().catch(() => ({}));
        errorMessage = json.error?.message ?? 'Gagal membuat tiket.';
      }
    }
  } catch {
    errorMessage = 'Tidak dapat terhubung ke server.';
  }
}
---

<Layout title="Buat Tiket — EONET">
  <main class="portal-container">
    <CustomerNav active="tickets" />
    <div class="portal-content">
      <div class="portal-header">
        <a href="/portal/tickets" class="back-link">← Kembali</a>
        <h1>Buat Tiket Baru</h1>
      </div>

      {errorMessage && <div class="alert alert-error">{errorMessage}</div>}

      <form method="POST" class="ticket-form">
        <div class="form-group">
          <label for="subject">Subjek</label>
          <input type="text" id="subject" name="subject" required class="form-input" placeholder="Jelaskan masalah Anda secara singkat" />
        </div>

        <div class="form-group">
          <label for="category_id">Kategori (opsional)</label>
          <select id="category_id" name="category_id" class="form-input">
            <option value="">- Pilih kategori -</option>
            {categories.map((cat) => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label for="description">Deskripsi</label>
          <textarea id="description" name="description" required class="form-input" rows="6" placeholder="Jelaskan masalah Anda secara detail..." />
        </div>

        <div class="form-actions">
          <a href="/portal/tickets" class="btn btn-secondary">Batal</a>
          <button type="submit" class="btn btn-primary">Kirim Tiket</button>
        </div>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .portal-header { margin-bottom: 1.5rem; }
  .portal-header h1 { font-size: 1.5rem; font-weight: 700; margin-top: 0.5rem; }
  .back-link { color: var(--text-muted, #9ca3af); text-decoration: none; font-size: 0.875rem; }
  .back-link:hover { color: var(--text, #fff); }
  .ticket-form { max-width: 600px; }
  .form-group { margin-bottom: 1.25rem; }
  .form-group label { display: block; margin-bottom: 0.375rem; font-weight: 600; font-size: 0.875rem; }
  .form-input { width: 100%; padding: 0.5rem 0.75rem; background: var(--bg, #111); border: 1px solid var(--border, #333); border-radius: 6px; color: var(--text, #fff); font-size: 0.9rem; }
  .form-actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
</style>
