---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Layout title="Cek Invoice — EONET Connection">
  <Header />
  <main>
    <section class="customer-section">
      <div class="container">

        <!-- LOGIN CARD (shown initially) -->
        <div id="login-card">
          <div class="section-header">
            <div class="eyebrow">Self-service</div>
            <h1 class="section-title">Cek status invoice Anda</h1>
            <p class="section-subtitle">
              Masukkan nomor HP dan kode pelanggan untuk melihat informasi tagihan dan paket.
            </p>
          </div>

          <div class="auth-card surface-panel" id="auth-card" data-api-base={apiBase}>
            <form id="login-form" class="login-form" novalidate>
              <div class="field">
                <label for="phone" class="field-label">Nomor WhatsApp</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="field-input"
                  placeholder="6281234567890"
                  required
                  autocomplete="tel"
                  inputmode="numeric"
                />
                <span class="field-hint">Format: 628xxxxxxxxxx</span>
                <span class="field-error" id="err-phone"></span>
              </div>

              <div class="field">
                <label for="customer_no" class="field-label">Kode Pelanggan</label>
                <input
                  type="text"
                  id="customer_no"
                  name="customer_no"
                  class="field-input"
                  placeholder="Kode pelanggan Anda"
                  required
                  autocomplete="off"
                />
                <span class="field-error" id="err-customer_no"></span>
              </div>

              <div id="login-error" class="alert alert-error" hidden></div>

              ${turnstileSiteKey ? `<div class="cf-turnstile" data-sitekey="${turnstileSiteKey}" data-theme="dark" id="turnstile-widget"></div>` : ""}

              <button type="submit" class="btn btn-primary full-width" id="login-btn">
                Lihat Tagihan
              </button>
            </form>
          </div>
        </div>

        <!-- DASHBOARD (hidden until login success) -->
        <div id="dashboard" hidden>
          <div class="dashboard-grid">

            <!-- Customer Info -->
            <div class="surface-panel dash-card" id="dash-customer">
              <div class="card-header-row">
                <h2 class="card-title" id="cust-name">-</h2>
                <span class="status-badge" id="cust-status">-</span>
              </div>
              <dl class="info-list">
                <div class="info-row"><dt>No. HP</dt><dd id="cust-phone">-</dd></div>
                <div class="info-row"><dt>Kode</dt><dd id="cust-no">-</dd></div>
                <div class="info-row"><dt>Email</dt><dd id="cust-email">-</dd></div>
                <div class="info-row"><dt>Alamat</dt><dd id="cust-address">-</dd></div>
                <div class="info-row"><dt>Tgl Mulai</dt><dd id="cust-start">-</dd></div>
                <div class="info-row"><dt>Jatuh Tempo</dt><dd id="cust-due">-</dd></div>
              </dl>
            </div>

            <!-- Package Info -->
            <div class="surface-panel dash-card" id="dash-package">
              <h2 class="card-title">Paket Aktif</h2>
              <div class="pkg-name" id="pkg-name">-</div>
              <div class="pkg-speed" id="pkg-speed">-</div>
              <div class="pkg-price" id="pkg-price">-</div>
            </div>

            <!-- Summary bar -->
            <div class="summary-bar" id="dash-summary">
              <div class="summary-item">
                <span class="summary-num" id="sum-total">0</span>
                <span class="summary-label">Total Invoice</span>
              </div>
              <div class="summary-item summary-paid">
                <span class="summary-num" id="sum-paid">0</span>
                <span class="summary-label">Lunas</span>
              </div>
              <div class="summary-item summary-unpaid">
                <span class="summary-num" id="sum-unpaid">0</span>
                <span class="summary-label">Belum Lunas</span>
              </div>
            </div>

            <!-- Invoice Table -->
            <div class="surface-panel dash-card dash-table-card">
              <h2 class="card-title">Riwayat Invoice</h2>
              <div id="invoice-list" class="invoice-list">
                <p class="text-muted">Memuat...</p>
              </div>
            </div>

          </div>

          <div class="logout-row">
            <button class="btn btn-secondary" id="logout-btn">← Kembali</button>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const apiBase = document.getElementById("auth-card")?.dataset.apiBase ?? "http://localhost:3000";
  const turnstileSiteKey = document.getElementById("turnstile-widget")?.dataset.sitekey ?? "";

  const loginCard = document.getElementById("login-card")!;
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
  const loginError = document.getElementById("login-error") as HTMLDivElement;
  const dashboard = document.getElementById("dashboard")!;
  const logoutBtn = document.getElementById("logout-btn")!;

  function clearErrors() {
    document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
    document.querySelectorAll(".field-input").forEach((el) => el.classList.remove("field-input-error"));
    loginError.hidden = true;
  }

  function showFieldError(field: string, message: string) {
    const errEl = document.getElementById(`err-${field}`);
    const inputEl = document.getElementById(field);
    if (errEl) errEl.textContent = message;
    if (inputEl) inputEl.classList.add("field-input-error");
  }

  function setLoading(loading: boolean) {
    loginBtn.disabled = loading;
    loginBtn.textContent = loading ? "Memeriksa..." : "Lihat Tagihan";
  }

  function formatDate(dateStr: string | null | undefined) {
    if (!dateStr) return "-";
    const d = new Date(dateStr);
    return d.toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" });
  }

  function formatRupiah(amount: string | number) {
    return new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(Number(amount));
  }

  function statusClass(status: string) {
    const map: Record<string, string> = {
      paid: "badge-success",
      issued: "badge-info",
      overdue: "badge-danger",
      partially_paid: "badge-warn",
      cancelled: "badge-muted",
      draft: "badge-muted",
    };
    return map[status] ?? "badge-muted";
  }

  function statusLabel(status: string) {
    const map: Record<string, string> = {
      paid: "Lunas",
      issued: "Belum Bayar",
      overdue: "Jatuh Tempo",
      partially_paid: "Sebagian",
      cancelled: "Dibatalkan",
      draft: "Draft",
    };
    return map[status] ?? status;
  }

  function renderDashboard(data: any) {
    const c = data.customer;
    const pkg = data.package;
    const invoices = data.invoices ?? [];
    const counts = data.invoice_counts ?? { total: 0, paid: 0, unpaid: 0 };

    // Customer
    document.getElementById("cust-name")!.textContent = c.full_name;
    document.getElementById("cust-status")!.textContent = c.status === "active" ? "Aktif" : c.status;
    document.getElementById("cust-status")!.className = `status-badge ${c.status === "active" ? "badge-success" : "badge-warn"}`;
    document.getElementById("cust-phone")!.textContent = c.phone;
    document.getElementById("cust-no")!.textContent = c.customer_no;
    document.getElementById("cust-email")!.textContent = c.email ?? "-";
    document.getElementById("cust-address")!.textContent = c.address;
    document.getElementById("cust-start")!.textContent = formatDate(c.subscription_started_at);
    document.getElementById("cust-due")!.textContent = `Tgl ${c.due_day}`;

    // Package
    if (pkg) {
      document.getElementById("pkg-name")!.textContent = pkg.name;
      document.getElementById("pkg-speed")!.textContent = pkg.speed ?? `${pkg.download_mbps} Mbps ↓ / ${pkg.upload_mbps} Mbps ↑`;
      document.getElementById("pkg-price")!.textContent = `${formatRupiah(pkg.price)}/bln`;
      document.getElementById("dash-package")!.removeAttribute("hidden");
    } else {
      document.getElementById("dash-package")!.setAttribute("hidden", "");
    }

    // Summary
    document.getElementById("sum-total")!.textContent = String(counts.total);
    document.getElementById("sum-paid")!.textContent = String(counts.paid);
    document.getElementById("sum-unpaid")!.textContent = String(counts.unpaid);

    // Invoice list
    const list = document.getElementById("invoice-list")!;
    if (invoices.length === 0) {
      list.innerHTML = '<p class="text-muted">Belum ada invoice.</p>';
    } else {
      list.innerHTML = invoices
        .map(
          (inv: any) => `
        <div class="invoice-row">
          <div class="inv-top">
            <span class="inv-number">${inv.invoice_number}</span>
            <span class="inv-status ${statusClass(inv.status)}">${statusLabel(inv.status)}</span>
          </div>
          <div class="inv-meta">
            <span>${formatDate(inv.period_start)} — ${formatDate(inv.period_end)}</span>
            <span class="inv-due">Jatuh tempo: ${formatDate(inv.due_date)}</span>
          </div>
          <div class="inv-amounts">
            <span>Total: <strong>${formatRupiah(inv.total)}</strong></span>
            <span>Dibayar: <strong>${formatRupiah(inv.paid_amount)}</strong></span>
            ${Number(inv.remaining) > 0 ? `<span class="inv-remaining">Sisa: <strong>${formatRupiah(inv.remaining)}</strong></span>` : ""}
          </div>
          ${inv.payments?.length ? `
          <div class="inv-payments">
            ${inv.payments.map((p: any) => `
              <div class="pay-chip ${p.status === "success" ? "pay-success" : ""}">
                ${p.paymentNumber} · ${formatRupiah(p.amount)} · ${p.method} · ${formatDate(p.paidAt)}
              </div>
            `).join("")}
          </div>` : ""}
        </div>
      `
        )
        .join("");
    }

    // Show dashboard, hide login
    loginCard.hidden = true;
    dashboard.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const phone = (document.getElementById("phone") as HTMLInputElement).value.trim();
    const customerNo = (document.getElementById("customer_no") as HTMLInputElement).value.trim();

    if (!phone) { showFieldError("phone", "Nomor HP wajib diisi"); return; }
    if (!customerNo) { showFieldError("customer_no", "Kode pelanggan wajib diisi"); return; }

    setLoading(true);

    try {
      const turnstileToken = turnstileSiteKey ? (window as any).turnstile?.getResponse?.() ?? "" : "";
      if (turnstileSiteKey && !turnstileToken) {
        loginError.textContent = "Verifikasi keamanan diperlukan. Silakan muat ulang halaman.";
        loginError.hidden = false;
        return;
      }

      const res = await fetch(`${apiBase}/v1/public/customer/auth`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone, customer_no: customerNo, turnstile_token: turnstileToken || undefined }),
      });

      const result = await res.json();

      if (res.ok) {
        renderDashboard(result.data);
      } else {
        loginError.textContent = result.error ?? "Gagal memverifikasi data. Silakan coba lagi.";
        loginError.hidden = false;
      }
    } catch {
      loginError.textContent = "Gagal terhubung ke server. Periksa koneksi internet Anda.";
      loginError.hidden = false;
    } finally {
      setLoading(false);
    }
  });

  logoutBtn.addEventListener("click", () => {
    dashboard.hidden = true;
    loginCard.hidden = false;
    loginForm.reset();
    clearErrors();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  .customer-section {
    padding-top: 7.5rem;
    padding-bottom: 4rem;
  }

  .section-title {
    max-width: 18ch;
  }

  .auth-card {
    padding: var(--space-xl);
    max-width: 440px;
    margin-inline: auto;
  }

  .login-form {
    display: grid;
    gap: var(--space-lg);
  }

  .field {
    display: grid;
    gap: var(--space-xs);
  }

  .field-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-100);
  }

  .field-hint {
    font-size: 0.78rem;
    color: var(--text-300);
  }

  .field-input {
    padding: 0.8rem 0.95rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    background: rgba(4, 10, 20, 0.4);
    color: var(--text-50);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    width: 100%;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--accent-400);
    box-shadow: var(--shadow-focus);
  }

  .field-input::placeholder {
    color: var(--text-400);
  }

  .field-input-error {
    border-color: #f87171;
  }

  .field-error {
    font-size: 0.8rem;
    color: #f87171;
    min-height: 1.2em;
  }

  .alert {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .alert-error {
    background: rgba(248, 113, 113, 0.12);
    color: #fca5a5;
    border: 1px solid rgba(248, 113, 113, 0.3);
  }

  /* Dashboard */
  .dashboard-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .dash-card {
    padding: var(--space-lg);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-200);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    gap: var(--space-sm);
  }

  .card-header-row .card-title {
    margin-bottom: 0;
  }

  .status-badge {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .badge-success { background: rgba(52, 211, 153, 0.15); color: #6ee7b7; }
  .badge-info    { background: rgba(94, 234, 212, 0.12); color: var(--accent-300); }
  .badge-danger  { background: rgba(248, 113, 113, 0.12); color: #fca5a5; }
  .badge-warn    { background: rgba(251, 191, 36, 0.12); color: #fcd34d; }
  .badge-muted   { background: rgba(151, 174, 200, 0.1); color: var(--text-300); }

  .info-list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid rgba(151, 174, 200, 0.08);
  }

  .info-row dt {
    font-size: 0.82rem;
    color: var(--text-300);
    flex-shrink: 0;
  }

  .info-row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
    word-break: break-word;
  }

  .pkg-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-50);
  }

  .pkg-speed {
    font-size: 0.92rem;
    color: var(--accent-300);
    margin-top: var(--space-xs);
  }

  .pkg-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-50);
    margin-top: var(--space-sm);
  }

  /* Summary bar */
  .summary-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .summary-item {
    background: rgba(16, 37, 61, 0.6);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    text-align: center;
  }

  .summary-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-50);
  }

  .summary-label {
    font-size: 0.8rem;
    color: var(--text-300);
    margin-top: var(--space-2xs);
  }

  .summary-paid .summary-num { color: #6ee7b7; }
  .summary-unpaid .summary-num { color: #fca5a5; }

  /* Invoice list */
  .dash-table-card {
    overflow: visible;
  }

  .invoice-list {
    display: grid;
    gap: var(--space-sm);
  }

  .invoice-row {
    padding: var(--space-md);
    border: 1px solid rgba(151, 174, 200, 0.1);
    border-radius: var(--radius-md);
    background: rgba(4, 10, 20, 0.24);
    display: grid;
    gap: var(--space-sm);
  }

  .inv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .inv-number {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .inv-status {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .inv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: 0.82rem;
    color: var(--text-300);
  }

  .inv-due {
    color: #fca5a5;
  }

  .inv-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: 0.88rem;
    color: var(--text-200);
  }

  .inv-remaining strong {
    color: #fca5a5;
  }

  .inv-payments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px solid rgba(151, 174, 200, 0.08);
  }

  .pay-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(151, 174, 200, 0.08);
    color: var(--text-300);
  }

  .pay-success {
    background: rgba(52, 211, 153, 0.1);
    color: #6ee7b7;
  }

  .text-muted {
    color: var(--text-300);
    text-align: center;
    padding: var(--space-lg);
  }

  .logout-row {
    margin-top: var(--space-xl);
    text-align: center;
  }

  @media (max-width: 640px) {
    .customer-section {
      padding-top: 6.5rem;
    }
    .auth-card {
      padding: var(--space-lg);
    }
    .dash-card {
      padding: var(--space-md);
    }
    .summary-num {
      font-size: 1.3rem;
    }
  }
</style>
