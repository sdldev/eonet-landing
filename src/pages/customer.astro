---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Layout title="Cek Invoice — EONET Connection">
  <Header />
  <main>
    <section class="customer-section">
      <div class="container">

        <!-- LOGIN CARD (shown initially) -->
        <div id="login-card">
          <div class="section-header">
            <div class="eyebrow">Self-service</div>
            <h1 class="section-title">Cek status invoice Anda</h1>
            <p class="section-subtitle">
              Masukkan nomor HP dan kode pelanggan untuk melihat informasi tagihan dan paket.
            </p>
          </div>

          <div class="auth-card surface-panel" id="auth-card" data-api-base={apiBase}>
            <form id="login-form" class="login-form" novalidate>
              <div class="field">
                <label for="phone" class="field-label">Nomor WhatsApp</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="field-input"
                  placeholder="6281234567890"
                  required
                  autocomplete="tel"
                  inputmode="numeric"
                />
                <span class="field-hint">Format: 628xxxxxxxxxx</span>
                <span class="field-error" id="err-phone"></span>
              </div>

              <div class="field">
                <label for="customer_no" class="field-label">Kode Pelanggan</label>
                <input
                  type="text"
                  id="customer_no"
                  name="customer_no"
                  class="field-input"
                  placeholder="Kode pelanggan Anda"
                  required
                  autocomplete="off"
                />
                <span class="field-error" id="err-customer_no"></span>
              </div>

              <div id="login-error" class="alert alert-error" hidden></div>

              {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" id="turnstile-widget"></div>}

              <button type="submit" class="btn btn-primary full-width" id="login-btn">
                Lihat Tagihan
              </button>
            </form>
          </div>
        </div>

        <!-- DASHBOARD (hidden until login success) -->
        <div id="dashboard" hidden>
          <div class="dashboard-grid">

            <!-- Current Month Status (HERO) -->
            <div class="surface-panel dash-hero" id="dash-hero">
              <div class="hero-status" id="hero-status">
                <div class="hero-icon" id="hero-icon">⏳</div>
                <div class="hero-text">
                  <h2 id="hero-title">Memuat...</h2>
                  <p id="hero-subtitle"></p>
                </div>
              </div>
              <div class="hero-actions" id="hero-actions"></div>
            </div>

            <!-- Package + Customer Info (2 columns) -->
            <div class="info-grid">
              <div class="surface-panel dash-card">
                <h3 class="card-title">Paket Aktif</h3>
                <div class="pkg-name" id="pkg-name">-</div>
                <div class="pkg-speed" id="pkg-speed">-</div>
                <div class="pkg-price" id="pkg-price">-</div>
              </div>
              <div class="surface-panel dash-card">
                <h3 class="card-title">Data Pelanggan</h3>
                <dl class="info-list">
                  <div class="info-row"><dt>Nama</dt><dd id="cust-name">-</dd></div>
                  <div class="info-row"><dt>No. WhatsApp</dt><dd id="cust-phone">-</dd></div>
                  <div class="info-row"><dt>Kode</dt><dd id="cust-no">-</dd></div>
                  <div class="info-row"><dt>Alamat</dt><dd id="cust-address">-</dd></div>
                  <div class="info-row"><dt>Tgl Jatuh Tempo</dt><dd id="cust-due">-</dd></div>
                </dl>
              </div>
            </div>

            <!-- Invoice History -->
            <div class="surface-panel dash-card dash-table-card">
              <div class="card-header-row">
                <h3 class="card-title">Riwayat Invoice</h3>
                <div class="summary-chips">
                  <span class="chip chip-success" id="sum-paid">0 Lunas</span>
                  <span class="chip chip-danger" id="sum-unpaid">0 Belum</span>
                </div>
              </div>
              <div id="invoice-list" class="invoice-list">
                <p class="text-muted">Memuat...</p>
              </div>
            </div>

          </div>

          <div class="logout-row">
            <button class="btn btn-secondary" id="logout-btn">← Kembali</button>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer data-cfasync="false"></script>
<script>
  const apiBase = document.getElementById("auth-card")?.dataset.apiBase ?? "http://localhost:3000";
  const turnstileSiteKey = document.getElementById("turnstile-widget")?.dataset.sitekey ?? "";

  const loginCard = document.getElementById("login-card")!;
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
  const loginError = document.getElementById("login-error") as HTMLDivElement;
  const dashboard = document.getElementById("dashboard")!;
  const logoutBtn = document.getElementById("logout-btn")!;

  function clearErrors() {
    document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
    document.querySelectorAll(".field-input").forEach((el) => el.classList.remove("field-input-error"));
    loginError.hidden = true;
  }

  function showFieldError(field: string, message: string) {
    const errEl = document.getElementById(`err-${field}`);
    const inputEl = document.getElementById(field);
    if (errEl) errEl.textContent = message;
    if (inputEl) inputEl.classList.add("field-input-error");
  }

  function setLoading(loading: boolean) {
    loginBtn.disabled = loading;
    loginBtn.textContent = loading ? "Memeriksa..." : "Lihat Tagihan";
  }

  function formatDate(dateStr: string | null | undefined) {
    if (!dateStr) return "-";
    const d = new Date(dateStr);
    return d.toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" });
  }

  function formatRupiah(amount: string | number) {
    return new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(Number(amount));
  }

  function statusClass(status: string) {
    const map: Record<string, string> = {
      paid: "badge-success",
      issued: "badge-info",
      overdue: "badge-danger",
      partially_paid: "badge-warn",
      cancelled: "badge-muted",
      draft: "badge-muted",
    };
    return map[status] ?? "badge-muted";
  }

  function statusLabel(status: string) {
    const map: Record<string, string> = {
      paid: "Lunas",
      issued: "Belum Bayar",
      overdue: "Jatuh Tempo",
      partially_paid: "Sebagian",
      cancelled: "Dibatalkan",
      draft: "Draft",
    };
    return map[status] ?? status;
  }

  function renderDashboard(data) {
    const c = data.customer;
    const pkg = data.package;
    const invoices = data.invoices ?? [];
    const counts = data.invoice_counts ?? { total: 0, paid: 0, unpaid: 0 };

    // Find current month invoice
    const now = new Date();
    const currentInvoice = invoices.find((inv) => {
      const start = new Date(inv.period_start);
      return start.getUTCFullYear() === now.getFullYear() && start.getUTCMonth() === now.getMonth();
    });

    // Hero - Current Month Status
    const heroIcon = document.getElementById("hero-icon");
    const heroTitle = document.getElementById("hero-title");
    const heroSubtitle = document.getElementById("hero-subtitle");
    const heroActions = document.getElementById("hero-actions");
    const heroEl = document.getElementById("dash-hero");

    if (!currentInvoice) {
      heroIcon.textContent = "📋";
      heroTitle.textContent = "Belum ada tagihan bulan ini";
      heroSubtitle.textContent = "Invoice akan diterbitkan pada awal bulan.";
      heroEl.classList.add("hero-neutral");
    } else if (currentInvoice.status === "paid") {
      heroIcon.textContent = "✅";
      heroTitle.textContent = "Tagihan Bulan Ini Sudah Lunas";
      heroSubtitle.textContent = `${currentInvoice.invoice_number} — ${formatRupiah(currentInvoice.total)}`;
      heroEl.classList.add("hero-success");
    } else {
      const isOverdue = currentInvoice.status === "overdue";
      heroIcon.textContent = isOverdue ? "⚠️" : "💳";
      heroTitle.textContent = isOverdue ? "Tagihan Sudah Jatuh Tempo!" : "Tagihan Belum Dibayar";
      heroSubtitle.textContent = `${currentInvoice.invoice_number} — ${formatRupiah(currentInvoice.total)} (jatuh tempo: ${formatDate(currentInvoice.due_date)})`;
      heroEl.classList.add(isOverdue ? "hero-danger" : "hero-warn");
      if (currentInvoice.can_pay) {
        heroActions.innerHTML = `<a class="btn btn-primary" href="/pay/${currentInvoice.payment_token ?? ''}">Bayar Sekarang</a>`;
      }
    }

    // Package
    if (pkg) {
      document.getElementById("pkg-name").textContent = pkg.name;
      document.getElementById("pkg-speed").textContent = pkg.speed ?? `${pkg.download_mbps} Mbps ↓ / ${pkg.upload_mbps} Mbps ↑`;
      document.getElementById("pkg-price").textContent = `${formatRupiah(pkg.price)}/bln`;
    }

    // Customer info
    document.getElementById("cust-name").textContent = c.full_name;
    document.getElementById("cust-phone").textContent = c.phone;
    document.getElementById("cust-no").textContent = c.customer_no;
    document.getElementById("cust-address").textContent = c.address;
    document.getElementById("cust-due").textContent = `Setiap tanggal ${c.due_day}`;

    // Summary chips
    document.getElementById("sum-paid").textContent = `${counts.paid} Lunas`;
    document.getElementById("sum-unpaid").textContent = `${counts.unpaid} Belum`;

    // Invoice list
    const list = document.getElementById("invoice-list");
    if (invoices.length === 0) {
      list.innerHTML = '<p class="text-muted">Belum ada invoice.</p>';
    } else {
      list.innerHTML = invoices
        .map(
          (inv) => `
        <div class="invoice-row">
          <div class="inv-top">
            <span class="inv-number">${inv.invoice_number}</span>
            <span class="inv-status ${statusClass(inv.status)}">${statusLabel(inv.status)}</span>
          </div>
          <div class="inv-meta">
            <span>${formatDate(inv.period_start)} — ${formatDate(inv.period_end)}</span>
          </div>
          <div class="inv-amounts">
            <span>Total: <strong>${formatRupiah(inv.total)}</strong></span>
            ${inv.status === "paid" ? `<span class="inv-paid-label">✓ Lunas</span>` : Number(inv.remaining) > 0 ? `<span class="inv-remaining">Sisa: <strong>${formatRupiah(inv.remaining)}</strong></span>` : ""}
          </div>
        </div>
      `
        )
        .join("");
    }

    // Show dashboard, hide login
    loginCard.hidden = true;
    dashboard.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const phone = (document.getElementById("phone") as HTMLInputElement).value.trim();
    const customerNo = (document.getElementById("customer_no") as HTMLInputElement).value.trim();

    if (!phone) { showFieldError("phone", "Nomor HP wajib diisi"); return; }
    if (!customerNo) { showFieldError("customer_no", "Kode pelanggan wajib diisi"); return; }

    setLoading(true);

    try {
      const turnstileToken = turnstileSiteKey ? (window as any).turnstile?.getResponse?.() ?? "" : "";

      const res = await fetch(`${apiBase}/v1/public/customer/auth`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone, customer_no: customerNo, turnstile_token: turnstileToken || undefined }),
      });

      const result = await res.json();

      if (res.ok) {
        renderDashboard(result.data);
      } else {
        loginError.textContent = result.error ?? "Gagal memverifikasi data. Silakan coba lagi.";
        loginError.hidden = false;
      }
    } catch {
      loginError.textContent = "Gagal terhubung ke server. Periksa koneksi internet Anda.";
      loginError.hidden = false;
    } finally {
      setLoading(false);
    }
  });

  logoutBtn.addEventListener("click", () => {
    dashboard.hidden = true;
    loginCard.hidden = false;
    loginForm.reset();
    clearErrors();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  .customer-section {
    padding-top: 7.5rem;
    padding-bottom: 4rem;
  }

  .section-title {
    max-width: 18ch;
  }

  .auth-card {
    padding: var(--space-xl);
    max-width: 440px;
    margin-inline: auto;
  }

  .login-form {
    display: grid;
    gap: var(--space-lg);
  }

  .field {
    display: grid;
    gap: var(--space-xs);
  }

  .field-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-100);
  }

  .field-hint {
    font-size: 0.78rem;
    color: var(--text-300);
  }

  .field-input {
    padding: 0.8rem 0.95rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    background: rgba(4, 10, 20, 0.4);
    color: var(--text-50);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    width: 100%;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--accent-400);
    box-shadow: var(--shadow-focus);
  }

  .field-input::placeholder {
    color: var(--text-400);
  }

  .field-input-error {
    border-color: #f87171;
  }

  .field-error {
    font-size: 0.8rem;
    color: #f87171;
    min-height: 1.2em;
  }

  .alert {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .alert-error {
    background: rgba(248, 113, 113, 0.12);
    color: #fca5a5;
    border: 1px solid rgba(248, 113, 113, 0.3);
  }

  /* Dashboard */
  .dashboard-grid {
    display: grid;
    gap: var(--space-lg);
  }

  /* Hero - current month status */
  .dash-hero {
    padding: var(--space-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .hero-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .hero-text h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-50);
  }

  .hero-text p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--text-300);
  }

  .hero-success { border-left: 4px solid #34d399; }
  .hero-warn { border-left: 4px solid #fbbf24; }
  .hero-danger { border-left: 4px solid #f87171; }
  .hero-neutral { border-left: 4px solid var(--border-soft); }

  /* Info grid (2 col) */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .dash-card {
    padding: var(--space-lg);
  }

  .card-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-300);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-sm) 0;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    gap: var(--space-sm);
  }

  .card-header-row .card-title { margin-bottom: 0; }

  .pkg-name { font-size: 1.3rem; font-weight: 800; color: var(--text-50); }
  .pkg-speed { font-size: 0.9rem; color: var(--accent-300); margin-top: var(--space-xs); }
  .pkg-price { font-size: 1.4rem; font-weight: 800; color: var(--text-50); margin-top: var(--space-sm); }

  .info-list { display: grid; gap: var(--space-xs); margin: 0; }
  .info-row { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-xs) 0; border-bottom: 1px solid rgba(151,174,200,0.08); }
  .info-row:last-child { border-bottom: 0; }
  .info-row dt { font-size: 0.82rem; color: var(--text-300); flex-shrink: 0; }
  .info-row dd { margin: 0; font-weight: 600; text-align: right; word-break: break-word; font-size: 0.88rem; }

  /* Summary chips */
  .summary-chips { display: flex; gap: var(--space-xs); }
  .chip { padding: 0.25rem 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
  .chip-success { background: rgba(52,211,153,0.15); color: #6ee7b7; }
  .chip-danger { background: rgba(248,113,113,0.12); color: #fca5a5; }

  /* Invoice list */
  .invoice-list { display: grid; gap: var(--space-sm); }
  .invoice-row { padding: var(--space-md); border: 1px solid rgba(151,174,200,0.1); border-radius: var(--radius-md); background: rgba(4,10,20,0.24); display: grid; gap: var(--space-xs); }
  .inv-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); }
  .inv-number { font-weight: 700; font-size: 0.88rem; }
  .inv-status { padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.7rem; font-weight: 700; }
  .inv-meta { font-size: 0.8rem; color: var(--text-300); }
  .inv-amounts { display: flex; flex-wrap: wrap; gap: var(--space-md); font-size: 0.86rem; color: var(--text-200); }
  .inv-remaining strong { color: #fca5a5; }
  .inv-paid-label { color: #6ee7b7; font-weight: 600; font-size: 0.82rem; }

  .text-muted { color: var(--text-300); text-align: center; padding: var(--space-lg); }
  .logout-row { margin-top: var(--space-xl); text-align: center; }

  .status-badge { padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
  .badge-success { background: rgba(52,211,153,0.15); color: #6ee7b7; }
  .badge-info { background: rgba(94,234,212,0.12); color: var(--accent-300); }
  .badge-danger { background: rgba(248,113,113,0.12); color: #fca5a5; }
  .badge-warn { background: rgba(251,191,36,0.12); color: #fcd34d; }
  .badge-muted { background: rgba(151,174,200,0.1); color: var(--text-300); }

  @media (max-width: 640px) {
    .info-grid { grid-template-columns: 1fr; }
    .dash-hero { flex-direction: column; align-items: flex-start; }
    .dash-card { padding: var(--space-md); }
  }
</style>
