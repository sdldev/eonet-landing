---
---

<section id="home" class="hero">
    <div class="container hero-container">
        <div class="hero-content">
            <div class="eyebrow hero-eyebrow">
                Internet cepat stabil untuk rumah & bisnis
            </div>
            <h1 class="hero-title">
                Internet cepat stabil tanpa drama koneksi putus
            </h1>
            <p class="hero-subtitle">
                Pilih paket EONET langsung dari website, bandingkan kebutuhan
                Anda, lalu konsultasikan pemasangan lewat WhatsApp resmi.
            </p>

            <div class="hero-actions">
                <a href="#packages" class="btn btn-primary">Lihat Paket</a>
                <a
                    href="https://wa.me/6289624424649?text=Halo%20EONET%2C%20saya%20ingin%20konsultasi%20paket%20internet."
                    class="btn btn-secondary"
                    target="_blank"
                    rel="noreferrer"
                    >Konsultasi WhatsApp</a
                >
            </div>

            <div class="hero-trust" aria-label="Layanan untuk kebutuhan utama">
                <span class="trust-chip">Rumahan</span>
                <span class="trust-chip">Bisnis</span>
                <span class="trust-chip">Support lokal</span>
            </div>
        </div>

        <div class="hero-image">
            <div class="image-glow"></div>
            <img
                src="/eonet.avif"
                alt="EONET Technician"
                class="character-img"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        padding-top: 7.5rem;
        padding-bottom: 4rem;
        position: relative;
        overflow: hidden;
    }

    .hero-container {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
    }

    .hero-content {
        display: grid;
        gap: 1.25rem;
        align-items: start;
    }

    .hero-eyebrow {
        width: fit-content;
    }

    .hero-title {
        max-width: 11ch;
        font-size: clamp(2.4rem, 1.8rem + 2.5vw, 4.5rem);
        font-weight: 800;
        line-height: 1.02;
    }

    .hero-subtitle {
        max-width: 56ch;
        font-size: clamp(1rem, 0.96rem + 0.4vw, 1.18rem);
        color: var(--text-200);
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .hero-actions :global(.btn) {
        min-width: min(100%, 210px);
    }

    .hero-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .hero-image {
        position: relative;
        display: flex;
        justify-content: center;
        align-self: stretch;
    }

    .character-img {
        width: min(100%, 480px);
        height: auto;
        filter: drop-shadow(0 18px 40px rgba(2, 11, 24, 0.4));
        position: relative;
        z-index: 2;
        mask-image: linear-gradient(to bottom, black 82%, transparent 100%);
    }

    .image-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(72vw, 360px);
        aspect-ratio: 1;
        background: rgba(45, 212, 191, 0.28);
        filter: blur(96px);
        opacity: 0.9;
        z-index: 1;
        border-radius: 50%;
    }

    @media (max-width: 768px) {
        .hero {
            padding-top: 6.5rem;
            padding-bottom: 3rem;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .hero-title {
            max-width: 12ch;
        }

        .hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .hero-actions :global(.btn) {
            width: 100%;
        }

        .hero-image {
            order: 2;
        }
    }
</style>
