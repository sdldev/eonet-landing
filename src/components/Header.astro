---

---

<header class="header">
    <div class="container header-container">
        <a href="/" class="logo" aria-label="EONET Connection">
            <span class="logo-icon" aria-hidden="true">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-8 h-8"
                >
                    <path
                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                    ></path>
                </svg>
            </span>
            <span class="logo-text"
                >EONET <span class="logo-sub">CONNECTION</span></span
            >
        </a>

        <nav class="nav">
            <a href="/" class="nav-link">Home</a>
            <a href="/register" class="nav-link">Daftar</a>
            <a href="/customer" class="nav-link">Cek Invoice</a>
            <a href="/portal/login" class="nav-link">Portal</a>
            <a href="/#contact" class="btn btn-secondary header-cta"
                >Hubungi Kami</a
            >
        </nav>
    </div>
</header>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: rgba(7, 18, 35, 0.82);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-soft);
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        min-height: 76px;
        padding-block: 0.85rem;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--text-50);
        font-weight: 700;
        font-size: 1.15rem;
    }

    .logo-icon {
        color: var(--accent-400);
        width: 28px;
        height: 28px;
        flex-shrink: 0;
    }

    .logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

    .logo-sub {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--text-300);
        text-transform: uppercase;
        line-height: 1;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .nav-link {
        color: var(--text-200);
        transition:
            color var(--transition-base),
            background-color var(--transition-base);
        font-weight: 500;
        font-size: 0.95rem;
        padding: 0.55rem 0.75rem;
        border-radius: 999px;
    }

    .nav-link:hover {
        color: var(--text-50);
        background: rgba(151, 174, 200, 0.12);
    }

    .header-cta {
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .header-container {
            min-height: 70px;
        }

        .nav-link {
            display: none;
        }

        .logo {
            font-size: 1rem;
        }

        .header-cta {
            padding-inline: 0.95rem;
        }
    }
</style>
