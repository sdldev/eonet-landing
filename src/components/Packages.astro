---
import { packages, faqs } from "../data/site";
import { buildWhatsAppUrl } from "../data/contact";
---

<section id="packages" class="packages-section section">
    <div class="container">
        <div class="section-header">
            <div class="eyebrow">Cek paket di website</div>
            <h2 class="section-title">Bandingkan paket EONET sebelum konsultasi</h2>
            <p class="section-subtitle">
                Lihat kecepatan, harga, perangkat ideal, dan dukungan tiap paket
                tanpa harus pindah halaman.
            </p>
        </div>

        <div class="packages-grid">
            {
                packages.map((pkg) => (
                    <article class="package-card surface-panel">
                        <div class="card-header">
                            <p class="package-label">{pkg.package}</p>
                            <h3 class="package-name">{pkg.speed}</h3>
                        </div>

                        <div class="card-body">
                            <div class="price-container">
                                <span class="currency">Rp</span>
                                <span class="amount">{pkg.price}</span>
                                <span class="period">/bln</span>
                            </div>
                            <p class="package-summary">Untuk {pkg.devices} perangkat ideal</p>
                        </div>

                        <div class="card-footer">
                            <a
                                href={buildWhatsAppUrl(`Halo EONET, saya ingin konsultasi ${pkg.package}.`)}
                                class="btn btn-primary full-width"
                                target="_blank"
                                rel="noreferrer"
                            >
                                Konsultasi paket ini
                            </a>
                        </div>

                        <dl class="details-list">
                                <div class="detail-item">
                                    <dt>Nama paket</dt>
                                    <dd>{pkg.package}</dd>
                                </div>
                                <div class="detail-item">
                                    <dt>Kecepatan</dt>
                                    <dd>{pkg.speed}</dd>
                                </div>
                                <div class="detail-item">
                                    <dt>Perangkat ideal</dt>
                                    <dd>{pkg.devices} perangkat</dd>
                                </div>
                                <div class="detail-item">
                                    <dt>Dukungan</dt>
                                    <dd>Konsultasi WhatsApp</dd>
                                </div>
                        </dl>
                    </article>
                ))
            }
        </div>

        <div class="faq-block surface-panel" aria-labelledby="packages-faq-title">
            <div class="faq-copy">
                <div class="eyebrow">FAQ sebelum pasang</div>
                <h3 id="packages-faq-title">Pertanyaan sebelum konsultasi</h3>
                <p>
                    Bandingkan paket di website terlebih dahulu, lalu gunakan
                    WhatsApp resmi untuk cek area dan konfirmasi pemasangan.
                </p>
            </div>

            <div class="faq-list">
                {
                    faqs.map((faq) => (
                        <article class="faq-item">
                            <h4>{faq.question}</h4>
                            <p>{faq.answer}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .packages-section {
        background: linear-gradient(
            180deg,
            rgba(4, 10, 20, 0.2) 0%,
            rgba(7, 18, 35, 0.96) 18%,
            rgba(4, 10, 20, 1) 100%
        );
    }

    .section-header {
        justify-items: start;
    }

    .section-title {
        max-width: 14ch;
    }

    .packages-grid {
        display: grid;
        gap: var(--space-lg);
    }

    .package-card {
        display: grid;
        gap: var(--space-lg);
        padding: var(--space-lg);
        transition:
            transform var(--transition-base),
            border-color var(--transition-base),
            box-shadow var(--transition-base),
            background var(--transition-base);
        position: relative;
        isolation: isolate;
    }

    .package-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top right, rgba(45, 212, 191, 0.2), transparent 34%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 42%);
        pointer-events: none;
        z-index: -1;
    }

    .package-card:hover {
        transform: translateY(-4px);
        border-color: rgba(94, 234, 212, 0.36);
        box-shadow: var(--shadow-medium);
    }

    .card-header {
        display: grid;
        gap: var(--space-xs);
    }

    .package-label {
        color: var(--accent-300);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .package-name {
        font-size: clamp(1.8rem, 1.35rem + 2.4vw, 2.8rem);
        font-weight: 800;
        line-height: 1;
        color: var(--text-50);
        max-width: 7ch;
    }

    .package-summary {
        color: var(--text-200);
        font-size: 0.98rem;
    }

    .price-container {
        display: flex;
        align-items: baseline;
        gap: var(--space-2xs);
        padding-block: var(--space-sm) 0;
        border-top: 1px solid rgba(151, 174, 200, 0.14);
    }

    .currency {
        font-size: 0.95rem;
        color: var(--text-300);
    }

    .amount {
        font-size: clamp(2.6rem, 2rem + 2vw, 3.35rem);
        font-weight: 800;
        line-height: 1;
        background: linear-gradient(135deg, var(--text-50), var(--accent-300));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .period {
        font-size: 0.9rem;
        color: var(--text-300);
    }

    .card-body {
        display: grid;
        gap: var(--space-md);
    }

    .details-list {
        display: grid;
        gap: var(--space-sm);
        margin: 0;
    }

    .detail-item {
        display: grid;
        gap: var(--space-2xs);
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-md);
        border: 1px solid rgba(151, 174, 200, 0.14);
        background: rgba(4, 10, 20, 0.24);
    }

    .detail-item dt {
        color: var(--text-300);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .detail-item dd {
        margin: 0;
        color: var(--text-50);
        font-size: 1rem;
        font-weight: 600;
    }

    .card-footer {
        margin-top: auto;
    }

    .full-width {
        display: block;
        text-align: center;
    }

    .card-footer :global(.btn) {
        min-height: calc(var(--tap-target-min) + 0.25rem);
        box-shadow: 0 16px 28px rgba(45, 212, 191, 0.2);
    }

    .faq-block {
        display: grid;
        gap: var(--space-lg);
        margin-top: var(--space-xl);
        padding: var(--space-lg);
    }

    .faq-copy {
        display: grid;
        gap: var(--space-md);
    }

    .faq-copy h3 {
        font-size: clamp(1.45rem, 1.1rem + 1.6vw, 2.25rem);
        color: var(--text-50);
    }

    .faq-copy p,
    .faq-item p {
        color: var(--text-200);
    }

    .faq-list {
        display: grid;
        gap: var(--space-sm);
    }

    .faq-item {
        display: grid;
        gap: var(--space-xs);
        padding: var(--space-md);
        border-radius: var(--radius-md);
        border: 1px solid rgba(151, 174, 200, 0.14);
        background: rgba(4, 10, 20, 0.24);
    }

    .faq-item h4 {
        font-size: 1rem;
        color: var(--text-50);
    }

    @media (min-width: 641px) {
        .packages-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .packages-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .faq-block {
            grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
            align-items: start;
        }
    }

    @media (max-width: 640px) {
        .package-card {
            padding: var(--space-md);
        }

        .package-name {
            max-width: none;
        }
    }
</style>
