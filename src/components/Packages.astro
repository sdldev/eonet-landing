---
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000";

let packages = [];
let fetchError = false;

try {
    const res = await fetch(`${apiBase}/v1/public/packages`);
    if (res.ok) {
        const body = await res.json();
        packages = body.data ?? [];
    } else {
        fetchError = true;
    }
} catch {
    fetchError = true;
}

function formatPrice(n: number) {
    return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(n);
}
---

<section id="packages" class="packages-section section">
    <div class="container">
        <div class="section-header pkg-header">
            <div class="eyebrow">Paket internet EONET</div>
            <h2 class="section-title">Pilih kecepatan sesuai kebutuhan Anda</h2>
            <p class="section-subtitle">Bandingkan paket, lihat use-case yang cocok, lalu konsultasi area pemasangan langsung via WhatsApp.</p>
        </div>

        <div class="pkg-grid" id="pkg-grid">
            {fetchError && (
                <div class="pkg-message surface-panel">
                    <strong>Gagal memuat paket</strong>
                    <p>Coba muat ulang halaman atau konsultasi langsung melalui WhatsApp resmi EONET.</p>
                </div>
            )}

            {!fetchError && packages.length === 0 && (
                <div class="pkg-message surface-panel">
                    <strong>Paket sedang diperbarui</strong>
                    <p>Silakan hubungi WhatsApp EONET untuk rekomendasi paket terbaru di area Anda.</p>
                </div>
            )}

            {packages.map((p: any) => {
                const dl = Number(p.downloadMbps ?? p.speed ?? 0);
                const ul = p.uploadMbps;
                const dur = p.durationDays ? `${p.durationDays} hari` : "30 hari";
                const promo = p.segment === "promo";

                return (
                    <article class:list={["pkg-card", "surface-panel", { "pkg-card--popular": promo }]}>
                        {promo && <div class="pkg-popular-badge">⭐ Paling diminati</div>}

                        <div class="pkg-tier">
                            <span class="pkg-name">{p.name}</span>
                        </div>

                        <div class="pkg-speed">
                            <span class="pkg-speed-num">{dl}<span class="pkg-speed-unit">Mbps</span></span>
                        </div>

                        <div class="pkg-price-block">
                            <span class="pkg-price-from">Mulai dari</span>
                            <div class="pkg-price">{formatPrice(Number(p.price))}<span class="pkg-price-period">/bulan</span></div>
                        </div>

                        <ul class="pkg-specs">
                            {dl > 0 && <li><span class="spec-label">Download</span><span class="spec-value">{dl} Mbps</span></li>}
                            {ul && <li><span class="spec-label">Upload</span><span class="spec-value">{ul} Mbps</span></li>}
                            <li><span class="spec-label">Masa aktif</span><span class="spec-value">{dur}</span></li>
                        </ul>

                        <a class:list={["pkg-cta", { "pkg-cta--primary": promo }]} href={`/register?package=${p.id}`}>
                            <span>Daftar Sekarang</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    </article>
                );
            })}
        </div>

        {!fetchError && packages.length > 0 && (
            <div class="pkg-dots" id="pkg-dots">
                {packages.map((_: any, i: number) => (
                    <span class:list={["pkg-dot", { active: i === 0 }]} data-index={i}></span>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .packages-section {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(ellipse at 20% 0%, rgba(45, 212, 191, 0.12), transparent 50%),
            radial-gradient(ellipse at 80% 100%, rgba(59, 130, 246, 0.08), transparent 50%),
            linear-gradient(180deg, rgba(4, 10, 20, 0.2), rgba(7, 18, 35, 0.98) 15%, var(--bg-950));
    }
    .packages-section::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(151, 174, 200, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(151, 174, 200, 0.03) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: linear-gradient(180deg, transparent, #000 20%, #000 80%, transparent);
    }
    .packages-section .container { position: relative; z-index: 1; }

    .pkg-header { justify-items: center; text-align: center; }
    .pkg-header .section-title { max-width: 22ch; }

    .pkg-grid {
        display: flex;
        gap: 0.85rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 0.5rem;
    }
    .pkg-grid::-webkit-scrollbar { display: none; }
    .pkg-grid { scrollbar-width: none; }

    .pkg-card {
        min-width: 260px;
        flex: 0 0 75%;
        scroll-snap-align: start;
    }

    .pkg-card {
        position: relative;
        padding: 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .pkg-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: radial-gradient(ellipse at 50% 0%, rgba(94, 234, 212, 0.06), transparent 60%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .pkg-card:hover {
        transform: translateY(-4px);
        border-color: rgba(94, 234, 212, 0.35);
        box-shadow: 0 20px 50px rgba(2, 11, 24, 0.5), 0 0 0 1px rgba(94, 234, 212, 0.06) inset;
    }
    .pkg-card:hover::before { opacity: 1; }

    .pkg-card--popular {
        border-color: rgba(45, 212, 191, 0.4);
        background:
            linear-gradient(160deg, rgba(45, 212, 191, 0.1), rgba(59, 130, 246, 0.05) 40%, rgba(10, 27, 49, 0.95)),
            linear-gradient(160deg, rgba(16, 37, 61, 0.92), rgba(10, 27, 49, 0.95));
        box-shadow: 0 12px 40px rgba(45, 212, 191, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .pkg-popular-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #fbbf24, #f97316);
        color: #1f1300;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        box-shadow: 0 6px 16px rgba(249, 115, 22, 0.2);
    }

    .pkg-tier { display: flex; flex-direction: column; gap: 0.2rem; }
    .pkg-name {
        color: var(--text-50);
        font-size: 0.95rem;
        font-weight: 800;
    }

    .pkg-speed {
        display: flex;
        align-items: baseline;
        gap: 0.2rem;
        padding-block: 0.15rem;
    }
    .pkg-speed-num {
        font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem);
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: -0.05em;
        color: var(--text-50);
    }
    .pkg-speed-unit {
        color: var(--accent-400);
        font-size: 0.75em;
        font-weight: 800;
        margin-left: 0.25rem;
    }

    .pkg-price-block {
        padding: 0.75rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(151, 174, 200, 0.12);
        background: rgba(4, 10, 20, 0.4);
    }
    .pkg-price-from {
        display: block;
        color: var(--text-400);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.2rem;
    }
    .pkg-price {
        color: var(--text-50);
        font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.25rem);
        font-weight: 900;
        letter-spacing: -0.03em;
    }
    .pkg-price-period {
        color: var(--text-400);
        font-size: 0.8rem;
        font-weight: 600;
        margin-left: 0.15rem;
    }

    .pkg-specs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.4rem;
    }
    .pkg-specs li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid rgba(151, 174, 200, 0.08);
        font-size: 0.8rem;
    }
    .pkg-specs li:last-child { border-bottom: none; padding-bottom: 0; }
    .spec-label { color: var(--text-300); }
    .spec-value { color: var(--text-50); font-weight: 700; }

    .pkg-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-height: 2.5rem;
        margin-top: auto;
        padding: 0.6rem 0.85rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(94, 234, 212, 0.22);
        background: rgba(94, 234, 212, 0.06);
        color: var(--accent-300);
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .pkg-cta:hover {
        transform: translateY(-1px);
        background: rgba(94, 234, 212, 0.12);
        border-color: rgba(94, 234, 212, 0.4);
        color: #fff;
    }
    .pkg-cta--primary {
        background: linear-gradient(135deg, var(--accent-500), #38bdf8);
        color: var(--accent-ink);
        border-color: transparent;
        box-shadow: 0 10px 24px rgba(45, 212, 191, 0.2);
    }
    .pkg-cta--primary:hover {
        box-shadow: 0 14px 32px rgba(45, 212, 191, 0.28);
        color: var(--accent-ink);
    }

    .pkg-message {
        grid-column: 1 / -1;
        padding: 2rem;
        text-align: center;
    }
    .pkg-message strong { display: block; color: var(--text-50); font-size: 1.15rem; }
    .pkg-message p { margin-top: 0.4rem; color: var(--text-200); }

    .pkg-dots {
        display: flex;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }
    .pkg-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(151, 174, 200, 0.25);
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .pkg-dot.active {
        background: var(--accent-400);
        transform: scale(1.3);
    }

    @media (min-width: 641px) {
        .pkg-dots { display: none; }
        .pkg-grid { flex-wrap: wrap; overflow-x: visible; scroll-snap-type: none; }
        .pkg-card { flex: 0 0 calc(50% - 0.45rem); min-width: 0; scroll-snap-align: none; }
    }
    @media (min-width: 1024px) {
        .pkg-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; }
        .pkg-card { flex: unset; min-width: 0; }
        .pkg-card--popular { transform: translateY(-0.4rem); }
        .pkg-card--popular:hover { transform: translateY(-0.7rem); }
    }
</style>

<script>
  const grid = document.getElementById("pkg-grid");
  const dots = document.querySelectorAll(".pkg-dot");
  if (grid && dots.length) {
    const cards = grid.querySelectorAll(".pkg-card");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Array.from(cards).indexOf(entry.target as Element);
            dots.forEach((d, i) => d.classList.toggle("active", i === idx));
          }
        });
      },
      { root: grid, threshold: 0.6 }
    );
    cards.forEach((c) => observer.observe(c));
  }
</script>
