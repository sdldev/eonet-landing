---
interface Props {
  active: 'dashboard' | 'invoices' | 'profile' | 'wifi' | 'tickets';
}

const { active } = Astro.props;
---

<!-- Mobile menu toggle -->
<button class="portal-menu-toggle" id="portal-menu-toggle" aria-label="Toggle menu">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
  </svg>
</button>

<!-- Overlay for mobile -->
<div class="portal-overlay" id="portal-overlay"></div>

<aside class="portal-sidebar" id="portal-sidebar">
  <a href="/" class="portal-sidebar-logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
    </svg>
    <span>EONET Portal</span>
  </a>

  <nav class="portal-nav">
    <a href="/portal/dashboard" class={`portal-nav-link ${active === 'dashboard' ? 'active' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
      </svg>
      Dashboard
    </a>
    <a href="/portal/invoices" class={`portal-nav-link ${active === 'invoices' ? 'active' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
      </svg>
      Tagihan
    </a>
    <a href="/portal/profile" class={`portal-nav-link ${active === 'profile' ? 'active' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
      </svg>
      Profil
    </a>
    <a href="/portal/wifi" class={`portal-nav-link ${active === 'wifi' ? 'active' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/>
      </svg>
      WiFi
    </a>
    <a href="/portal/tickets" class={`portal-nav-link ${active === 'tickets' ? 'active' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
      </svg>
      Helpdesk
    </a>

    <div class="portal-nav-logout">
      <a href="#" class="portal-nav-link" id="portal-logout-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
        </svg>
        Keluar
      </a>
    </div>
  </nav>
</aside>

<script>
  // Mobile sidebar toggle
  const toggle = document.getElementById('portal-menu-toggle');
  const sidebar = document.getElementById('portal-sidebar');
  const overlay = document.getElementById('portal-overlay');

  function closeSidebar() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
  }

  toggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
    overlay?.classList.toggle('open');
  });

  overlay?.addEventListener('click', closeSidebar);

  // Logout
  const logoutBtn = document.getElementById('portal-logout-btn');
  logoutBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    try {
      const csrf = document.cookie.match(/eonet_customer_csrf=([^;]+)/)?.[1] ?? '';
      await fetch('/api/v1/customer/auth/logout', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf },
        credentials: 'include',
      });
    } catch {
      // ignore errors, still redirect
    }
    window.location.href = '/portal/login';
  });
</script>
