---

---

<section id="features" class="features-section section">
    <div class="container">
        <div class="section-header">
            <div class="eyebrow">Trust & coverage</div>
            <h2 class="section-title">Lebih jelas sebelum pasang</h2>
            <p class="section-subtitle">
                EONET membantu Anda memilih paket dari website, lalu memastikan
                detail area, biaya, dan langkah pemasangan lewat WhatsApp resmi.
            </p>
        </div>

        <div class="features-grid">
            <div class="feature-item surface-panel">
                <div class="feature-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                        ></path>
                    </svg>
                </div>
                <h3 class="feature-title">Koneksi stabil untuk aktivitas harian</h3>
                <p class="feature-desc">
                    Dirancang untuk kebutuhan rumah dan usaha seperti meeting,
                    belajar online, streaming, dan gaming sesuai kondisi jaringan
                    di lokasi Anda.
                </p>
            </div>

            <div class="feature-item surface-panel">
                <div class="feature-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="feature-title">Support lokal mudah dihubungi</h3>
                <p class="feature-desc">
                    Konsultasi paket, cek area, dan tindak lanjut pemasangan
                    dilakukan melalui WhatsApp resmi EONET agar percakapan tetap
                    mudah dilacak.
                </p>
            </div>

            <div class="feature-item surface-panel coverage-item">
                <div class="feature-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689A1.125 1.125 0 003 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="feature-title">Paket transparan sebelum pasang</h3>
                <p class="feature-desc">
                    Area layanan, biaya, dan konfirmasi teknis dijelaskan lebih
                    dulu sebelum pemasangan. Ketersediaan akhir tetap dicek dari
                    lokasi pelanggan.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .features-section {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        background: linear-gradient(180deg, rgba(4, 10, 20, 0.92), rgba(7, 18, 35, 0.72));
    }

    .features-grid {
        display: grid;
        gap: var(--space-lg);
    }

    .feature-item {
        padding: var(--space-lg);
        position: relative;
        isolation: isolate;
    }

    .feature-item::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(45, 212, 191, 0.16), transparent 36%);
        pointer-events: none;
        z-index: -1;
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        background: rgba(45, 212, 191, 0.14);
        color: var(--accent-300);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-lg);
    }

    .feature-icon svg {
        width: 24px;
        height: 24px;
    }

    .feature-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: var(--space-sm);
        color: var(--text-50);
    }

    .feature-desc {
        color: var(--text-200);
        font-size: 0.95rem;
    }

    @media (min-width: 768px) {
        .features-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
