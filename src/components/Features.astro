---
import { trustSignals } from "../data/site";
---

<section id="features" class="features-section section">
    <div class="container">
        <div class="section-header">
            <div class="eyebrow">Trust & coverage</div>
            <h2 class="section-title">Lebih jelas sebelum pasang</h2>
            <p class="section-subtitle">
                EONET membantu Anda memilih paket dari website, lalu memastikan
                detail area, biaya, dan langkah pemasangan lewat WhatsApp resmi.
            </p>
        </div>

        <div class="features-grid">
            {
                trustSignals.map((signal) => (
                    <div class="feature-item surface-panel">
                        <div class="feature-icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="w-6 h-6"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 12.75L11.25 15 15 9.75m6-1.5c0 5.213-3.438 9.625-8.172 11.096a.75.75 0 01-.656 0C7.438 17.875 4 13.463 4 8.25V5.818c0-.337.225-.632.55-.716a12.035 12.035 0 007.45-4.1.75.75 0 011 0 12.035 12.035 0 007.45 4.1c.325.084.55.379.55.716V8.25z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="feature-title">{signal.title}</h3>
                        <p class="feature-desc">{signal.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .features-section {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        background: linear-gradient(180deg, rgba(4, 10, 20, 0.92), rgba(7, 18, 35, 0.72));
    }

    .features-grid {
        display: grid;
        gap: var(--space-lg);
    }

    .feature-item {
        padding: var(--space-lg);
        position: relative;
        isolation: isolate;
    }

    .feature-item::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(45, 212, 191, 0.16), transparent 36%);
        pointer-events: none;
        z-index: -1;
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        background: rgba(45, 212, 191, 0.14);
        color: var(--accent-300);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-lg);
    }

    .feature-icon svg {
        width: 24px;
        height: 24px;
    }

    .feature-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: var(--space-sm);
        color: var(--text-50);
    }

    .feature-desc {
        color: var(--text-200);
        font-size: 0.95rem;
    }

    @media (min-width: 768px) {
        .features-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
