# EONET Landing — Environment Variables
# Copy this file to .env and adjust values
#
# Development (Docker):
#   1. Jalankan docker compose up dari workspace root (API + DB + Redis)
#   2. cp .env.example .env
#   3. npm run dev → buka http://localhost:4321
#   Landing page akan fetch data dari API di http://localhost:3000 (Docker)

# Billing API base URL (no trailing slash)
# Default: http://localhost:3000 (Docker API)
PUBLIC_API_BASE=http://localhost:3000

# Cloudflare Turnstile site key (optional — kosongkan untuk skip CAPTCHA)
# Dapatkan dari https://dash.cloudflare.com/ → Turnstile → Add Site
PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp number for contact links (without +, e.g. 6289624424649)
PUBLIC_WA_NUMBER=6289624424649

# Midtrans Snap (client-side popup payment)
# Dapatkan dari https://dashboard.midtrans.com/ → Settings → Access Keys
PUBLIC_MIDTRANS_CLIENT_KEY=
# Set "true" untuk environment production, "false" untuk sandbox
PUBLIC_MIDTRANS_IS_PRODUCTION=false
