# eonet-landing — Production Environment Variables
# Copy this file to .env and adjust values

# API base URL (no trailing slash)
PUBLIC_API_BASE=https://api.eonet.id

# Cookie domain untuk shared auth
COOKIE_DOMAIN=.eonet.id

# Port untuk akses dari luar
PORT=4321

# Cloudflare Turnstile site key (optional)
PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp number for contact links (without +)
PUBLIC_WA_NUMBER=6289624424649

# Midtrans Snap
PUBLIC_MIDTRANS_CLIENT_KEY=
PUBLIC_MIDTRANS_IS_PRODUCTION=true

# Docker image (opsional, untuk pull dari registry)
# LANDING_IMAGE=ghcr.io/sdldev/eonet-landing
# LANDING_IMAGE_TAG=latest
